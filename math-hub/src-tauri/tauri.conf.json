{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "math-hub",
  "version": "0.1.0",
  "identifier": "com.donat.math-hub",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
  {
    "title": "Math Hub",
    "width": 1200,
    "height": 800,
    "decorations": false,
    "resizable": true,
    "alwaysOnTop": false,
    "center": true
  }
],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
