% --- 7. TEOREMI E BOX ---
\usepackage{mdframed}
\mdfdefinestyle{math_box}{
    linecolor=black!70, linewidth=0.8pt, roundcorner=2pt,
    innertopmargin=8pt, innerbottommargin=8pt,
    innerleftmargin=12pt, innerrightmargin=12pt,
    backgroundcolor=black!3
}
\theoremstyle{plain}
\newtheorem{thm}{Teorema}[chapter] 
\newtheorem{lem}[thm]{Lemma}
\newtheorem{prop}[thm]{Proposizione}
\newtheorem{cor}[thm]{Corollario}

\theoremstyle{definition}
\newtheorem{defn}{Definizione}[chapter]
\newtheorem{exmp}{Esempio}[chapter]
\newtheorem{exmpnr}{Esempio}[chapter] % <--- Presente nel tuo primo preambolo
\newtheorem{xca}[exmp]{Esercizio}

\theoremstyle{remark}
\newtheorem{rem}{Osservazione}
\newtheorem{note}{Nota}
\newtheorem{case}{Caso}

\surroundwithmdframed[style=math_box]{thm}
\surroundwithmdframed[style=math_box]{defn}
\surroundwithmdframed[style=math_box]{lem}
\surroundwithmdframed[style=math_box]{prop}
\surroundwithmdframed[style=math_box]{cor}

